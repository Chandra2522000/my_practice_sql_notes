SELECT  branch, marks, AVG(marks) over() as avg_marks
FROM marks;
SELECT  branch, marks, AVG(marks) over(partition by branch) as avg_marks
FROM marks;
SELECT  branch, marks, max(marks) over(partition by branch) as max_marks
FROM marks;
SELECT  name, marks, rank() over(order by marks desc) as stu_rank
FROM marks;
SELECT  name, marks, dense_rank() over(order by marks desc) as stu_rank
FROM marks;
